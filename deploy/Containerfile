# Base core container. This is not a service per-se but is used as a common layer for the core services.
FROM rockylinux/rockylinux:10 AS core

ARG PYTHON_VERSION=3.14

RUN dnf update -y && dnf install -y python"${PYTHON_VERSION}" python"${PYTHON_VERSION}"-pip git

WORKDIR /inginious
COPY pyproject.toml README.rst ./
COPY inginious/common/ inginious/common/
COPY inginious/__init__.py inginious/

# See https://github.com/pypa/setuptools_scm/#usage-from-docker
RUN --mount=source=.git,target=.git,type=bind \
    pip"${PYTHON_VERSION}" install --no-cache-dir -e .

##########
# BACKEND
##########
FROM core AS backend 

ENV  PYTHON_VERSION="${PYTHON_VERSION}"

COPY inginious/backend/ inginious/backend/
COPY inginious/scripts/ inginious/scripts/

# See https://github.com/pypa/setuptools_scm/#usage-from-docker
RUN  --mount=source=.git,target=.git,type=bind \
     pip"${PYTHON_VERSION}" install --no-cache-dir -e .

CMD  ["sh", "-c", "python${PYTHON_VERSION} -m inginious.scripts.backend ${AGENT} ${CLIENT}"]


###########
# FRONTEND
###########
FROM core AS frontend 

ENV  PYTHON_VERSION="${PYTHON_VERSION}"

COPY inginious/frontend inginious/frontend/
COPY inginious/client inginious/client/
COPY inginious/scripts inginious/scripts

# See https://github.com/pypa/setuptools_scm/#usage-from-docker
RUN  --mount=source=.git,target=.git,type=bind \
    pip"${PYTHON_VERSION}" install --no-cache-dir -e . &&\
    pip"${PYTHON_VERSION}" install 'gunicorn==26.0.0'

CMD ["sh", "-c", "python${PYTHON_VERSION} -m gunicorn.app.wsgiapp 'inginious.scripts.webapp:application' --bind 0.0.0.0"]


###########
# AGENT MCQ 
###########

FROM core AS agent_mcq

ENV  PYTHON_VERSION="${PYTHON_VERSION}"

COPY inginious/agent/__init__.py inginious/agent/
COPY inginious/agent/mcq_agent/ inginious/agent/mcq_agent/
COPY inginious/scripts inginious/scripts

# See https://github.com/pypa/setuptools_scm/#usage-from-docker
RUN --mount=source=.git,target=.git,type=bind \
    pip"${PYTHON_VERSION}" install --no-cache-dir -e .

CMD ["sh", "-c", "python${PYTHON_VERSION} -m inginious.scripts.agent_mcq ${BACKEND}"]

##############
# AGENT DOCKER
##############

FROM core AS agent_docker

ENV  PYTHON_VERSION="${PYTHON_VERSION}"

COPY inginious/agent/__init__.py inginious/agent/
COPY inginious/agent/docker_agent/ inginious/agent/docker_agent/
COPY inginious/scripts inginious/scripts

# See https://github.com/pypa/setuptools_scm/#usage-from-docker
RUN --mount=source=.git,target=.git,type=bind \
    pip"${PYTHON_VERSION}" install --no-cache-dir -e .

CMD ["sh", "-c", "python${PYTHON_VERSION} -m inginious.scripts.agent_docker ${BACKEND} --tmpdir=/tmp/agent_data/"]

###########
# WEBTERM
###########

# Web terminal for SSH remote debug (webterm config key in configuration.yaml).
# Vendored app in deploy/webterm/ (upstream INGInious/xterm + node-pty).
# node-pty compiles a native module: build tools are installed for the npm
# install and removed afterwards to keep the layer small. openssh-clients is
# the runtime dependency: the app pty-spawns `ssh` per debug session.
FROM rockylinux/rockylinux:10 AS webterm

RUN dnf update -y && dnf install -y nodejs npm openssh-clients gcc-c++ make python3 \
    && dnf clean all

WORKDIR /webterm
COPY deploy/webterm/package.json deploy/webterm/app.js deploy/webterm/index.html \
     deploy/webterm/main.js deploy/webterm/style.css ./
RUN npm install --omit=dev --no-cache \
    && dnf remove -y gcc-c++ make && dnf clean all
# (python3 stays: dnf depends on it, removing it breaks the package manager)

# WEBTERM_ALLOWED must match the agent --debug-host/--debug-ports, e.g.
# "host.docker.internal:64120-64130" (set by the compose files). Single $:
# exec-form CMD is not compose-interpolated.
CMD ["sh", "-c", "node app.js 0.0.0.0 3000 \"$WEBTERM_ALLOWED\""]

########
# WEBDAV
########
FROM core AS webdav

ENV  PYTHON_VERSION="${PYTHON_VERSION}"

COPY inginious/frontend inginious/frontend/
COPY inginious/client inginious/client/
COPY inginious/scripts inginious/scripts

# See https://github.com/pypa/setuptools_scm/#usage-from-docker
RUN --mount=source=.git,target=.git,type=bind \
    pip"${PYTHON_VERSION}" install --no-cache-dir -e . &&\
    pip"${PYTHON_VERSION}" install 'gunicorn==26.0.0'

CMD ["sh", "-c", "python${PYTHON_VERSION} -m gunicorn.app.wsgiapp 'inginious.scripts.webdav:application' --bind 0.0.0.0 --workers 1"]
