# Production entry point (rendered by terraform): plain HTTP behind the
# Cloudflare tunnel. The tunnel targets http://localhost:${web_bind_port} on
# the container; TLS terminates at the Cloudflare edge.
:${web_bind_port} {
	header -Server
	reverse_proxy frontend:8000
	handle /dav/* {
		reverse_proxy webdav:8000
	}
}
