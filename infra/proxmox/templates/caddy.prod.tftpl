# Production entry point (rendered by terraform): plain HTTP behind the
# serveo WireGuard tunnel. TLS terminates at the serveo edge, which sets
# X-Forwarded-Proto - used here to force-redirect plain HTTP to HTTPS.
:${web_bind_port} {
	@notsecure not header X-Forwarded-Proto https
	redir @notsecure https://{host}{uri} 308
	header -Server
	reverse_proxy frontend:8000
	handle /dav/* {
		reverse_proxy webdav:8000
	}
}
